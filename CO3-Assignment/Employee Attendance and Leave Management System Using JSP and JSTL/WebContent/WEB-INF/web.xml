<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1"
         metadata-complete="true">

    <display-name>Employee Attendance and Leave Management System</display-name>
    <description>Enterprise IT Employee Attendance and Leave Tracking Web Application</description>

    <!-- Welcome File -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- 1. Employee Login Servlet -->
    <servlet>
        <servlet-name>EmployeeLoginServlet</servlet-name>
        <servlet-class>servlet.EmployeeLoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EmployeeLoginServlet</servlet-name>
        <url-pattern>/EmployeeLoginServlet</url-pattern>
    </servlet-mapping>

    <!-- 2. Admin Login Servlet -->
    <servlet>
        <servlet-name>AdminLoginServlet</servlet-name>
        <servlet-class>servlet.AdminLoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminLoginServlet</servlet-name>
        <url-pattern>/AdminLoginServlet</url-pattern>
    </servlet-mapping>

    <!-- 3. Employee Dashboard Servlet -->
    <servlet>
        <servlet-name>EmployeeDashboardServlet</servlet-name>
        <servlet-class>servlet.EmployeeDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EmployeeDashboardServlet</servlet-name>
        <url-pattern>/EmployeeDashboardServlet</url-pattern>
    </servlet-mapping>

    <!-- 4. Admin Dashboard Servlet -->
    <servlet>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <servlet-class>servlet.AdminDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <url-pattern>/AdminDashboardServlet</url-pattern>
    </servlet-mapping>

    <!-- 5. Attendance Servlet -->
    <servlet>
        <servlet-name>AttendanceServlet</servlet-name>
        <servlet-class>servlet.AttendanceServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AttendanceServlet</servlet-name>
        <url-pattern>/AttendanceServlet</url-pattern>
    </servlet-mapping>

    <!-- 6. Leave Application Servlet -->
    <servlet>
        <servlet-name>LeaveApplicationServlet</servlet-name>
        <servlet-class>servlet.LeaveApplicationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LeaveApplicationServlet</servlet-name>
        <url-pattern>/LeaveApplicationServlet</url-pattern>
    </servlet-mapping>

    <!-- 7. Leave History Servlet -->
    <servlet>
        <servlet-name>LeaveHistoryServlet</servlet-name>
        <servlet-class>servlet.LeaveHistoryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LeaveHistoryServlet</servlet-name>
        <url-pattern>/LeaveHistoryServlet</url-pattern>
    </servlet-mapping>

    <!-- 8. Leave Approval Servlet -->
    <servlet>
        <servlet-name>LeaveApprovalServlet</servlet-name>
        <servlet-class>servlet.LeaveApprovalServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LeaveApprovalServlet</servlet-name>
        <url-pattern>/LeaveApprovalServlet</url-pattern>
    </servlet-mapping>

    <!-- 9. Employee Details Servlet -->
    <servlet>
        <servlet-name>EmployeeDetailsServlet</servlet-name>
        <servlet-class>servlet.EmployeeDetailsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EmployeeDetailsServlet</servlet-name>
        <url-pattern>/EmployeeDetailsServlet</url-pattern>
    </servlet-mapping>

    <!-- 10. Leave Requests Servlet -->
    <servlet>
        <servlet-name>LeaveRequestsServlet</servlet-name>
        <servlet-class>servlet.LeaveRequestsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LeaveRequestsServlet</servlet-name>
        <url-pattern>/LeaveRequestsServlet</url-pattern>
    </servlet-mapping>

    <!-- 11. Logout Servlet -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/LogoutServlet</url-pattern>
    </servlet-mapping>

    <!-- Session Timeout: 30 minutes -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

</web-app>
