<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Online Student Registration and Admission Management System</display-name>
    <description>
        Web-based student admission portal for engineering college admissions.
        Developed using HTML5, CSS3, JavaScript, Java Servlets (GET &amp; POST), and JSP.
    </description>

    <!-- Welcome File -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <!-- 1. Registration Servlet Configuration -->
    <servlet>
        <servlet-name>RegistrationServlet</servlet-name>
        <servlet-class>com.college.admission.RegistrationServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>

    <servlet-mapping>
        <servlet-name>RegistrationServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>RegistrationServlet</servlet-name>
        <url-pattern>/RegistrationServlet</url-pattern>
    </servlet-mapping>

    <!-- 2. Student Details Servlet Configuration -->
    <servlet>
        <servlet-name>StudentDetailsServlet</servlet-name>
        <servlet-class>com.college.admission.StudentDetailsServlet</servlet-class>
        <load-on-startup>2</load-on-startup>
    </servlet>

    <servlet-mapping>
        <servlet-name>StudentDetailsServlet</servlet-name>
        <url-pattern>/students</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>StudentDetailsServlet</servlet-name>
        <url-pattern>/StudentDetailsServlet</url-pattern>
    </servlet-mapping>

    <!-- Session Timeout Configuration (in minutes) -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

</web-app>
