<?xml version="1.0" encoding="UTF-8"?>
<!--
  XML-Based Library Book Catalogue and Management System
  XML Schema Definition (XSD) - books.xsd
  Defines structural rules, occurrence constraints, data types, and facet validations
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <!-- Root Element: library -->
  <xs:element name="library">
    <xs:complexType>
      <xs:sequence>
        <!-- Must contain at least 1 book, unbounded upper limit -->
        <xs:element name="book" maxOccurs="unbounded" minOccurs="1">
          <xs:complexType>
            <xs:sequence>
              <!-- Title: Non-empty string -->
              <xs:element name="title">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:minLength value="1"/>
                    <xs:maxLength value="250"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>

              <!-- Author: Non-empty string -->
              <xs:element name="author">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:minLength value="1"/>
                    <xs:maxLength value="150"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>

              <!-- Publisher: Non-empty string -->
              <xs:element name="publisher">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:minLength value="1"/>
                    <xs:maxLength value="150"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>

              <!-- ISBN: 10 or 13 digits string -->
              <xs:element name="isbn">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:pattern value="(\d{10}|\d{13})"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>

              <!-- Price: Positive decimal number greater than 0 -->
              <xs:element name="price">
                <xs:simpleType>
                  <xs:restriction base="xs:decimal">
                    <xs:minExclusive value="0.00"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>

              <!-- Publication Year: 4-digit positive integer between 1900 and 2099 -->
              <xs:element name="year">
                <xs:simpleType>
                  <xs:restriction base="xs:positiveInteger">
                    <xs:minInclusive value="1900"/>
                    <xs:maxInclusive value="2099"/>
                    <xs:pattern value="\d{4}"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
            </xs:sequence>

            <!-- Book ID: Required ID attribute conforming to B + numbers -->
            <xs:attribute name="id" use="required">
              <xs:simpleType>
                <xs:restriction base="xs:ID">
                  <xs:pattern value="B[0-9]{3,}"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:attribute>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>

    <!-- Ensure unique Book IDs across the library -->
    <xs:unique name="UniqueBookID">
      <xs:selector xpath="book"/>
      <xs:field xpath="@id"/>
    </xs:unique>
  </xs:element>

</xs:schema>
